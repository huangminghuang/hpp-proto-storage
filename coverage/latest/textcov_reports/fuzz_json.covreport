  103|     36|    value >>= static_cast<unsigned>(CHAR_BIT - 1);
  104|     36|  }
  105|    596|  *data++ = Byte(value);
  106|       |  // NOLINTEND(cppcoreguidelines-pro-bounds-pointer-arithmetic)

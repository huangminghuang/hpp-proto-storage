   44|       |    // NOLINTNEXTLINE(hicpp-signed-bitwise)
   45|       |    return varint_size(std::make_unsigned_t<decltype(value)>((value << 1) ^ (value >> (sizeof(value) * CHAR_BIT - 1))));
   46|  4.65k|  } else {
   47|  4.65k|    return ((sizeof(value) * CHAR_BIT) -
   48|  4.65k|            static_cast<unsigned>(std::countl_zero(std::make_unsigned_t<decltype(value)>(value) | 1U)) +
   49|  4.65k|            (CHAR_BIT - 2)) /
   50|       |           (CHAR_BIT - 1);
   51|  4.65k|  }
   52|  4.65k|}

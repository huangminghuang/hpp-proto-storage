   43|       |  if constexpr (Encoding == varint_encoding::zig_zag) {
   44|       |    return varint_size(std::make_unsigned_t<decltype(value)>(
   45|       |        (value << 1) ^ (value >> ((sizeof(value) * CHAR_BIT) - 1)))); // // NOLINT(hicpp-signed-bitwise)
   46|  5.73k|  } else {
   47|  5.73k|    return ((sizeof(value) * CHAR_BIT) -
   48|  5.73k|            static_cast<unsigned>(std::countl_zero(std::make_unsigned_t<decltype(value)>(value) | 1U)) +
   49|  5.73k|            (CHAR_BIT - 2)) /
   50|       |           (CHAR_BIT - 1);
   51|  5.73k|  }
   52|  5.73k|}

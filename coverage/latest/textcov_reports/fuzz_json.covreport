_ZN9hpp_proto4util20transform_accumulateINS_24equality_comparable_spanIKN6google8protobuf24EnumValueDescriptorProtoINS_17non_owning_traitsEEEEEZNS_13pb_serializer18size_cache_counterINS4_19FileDescriptorProtoIS6_EEE5countINS_10field_metaILj2EXadL_ZNS4_19EnumDescriptorProtoIS6_E5valueEEELNS_12field_optionE0EvXtlNSt3__19monostateEEEEETkNSK_6ranges11input_rangeES9_EEmRKT0_T_EUlRKSR_E_EEmST_SQ_:
   32|      2|constexpr uint64_t transform_accumulate(const Range &range, const UnaryOperation &unary_op) {
   33|       |  // **DO NOT** use std::transform_reduce() because it would apply unary_op in **unspecified** order
   34|      2|  auto total = std::accumulate(range.begin(), range.end(), uint64_t{0},
   35|      2|                               [&unary_op](uint64_t acc, const auto &elem) constexpr { return acc + unary_op(elem); });

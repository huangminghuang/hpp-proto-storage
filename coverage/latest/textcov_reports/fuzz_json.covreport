  127|       |  // ptr[0] = 1aaa aaaa ; res1 = 1111 1111 ... 1111 1111  1111 1111  1aaa aaaa
  128|       |  // ptr[1] = 1bbb bbbb ; res2 = 1111 1111 ... 1111 1111  11bb bbbb  b111 1111
  129|       |  // ptr[2] = 0ccc cccc ; res3 = 0000 0000 ... 000c cccc  cc11 1111  1111 1111
  130|       |  //                             ---------------------------------------------
  131|       |  //        res1 & res2 & res3 = 0000 0000 ... 000c cccc  ccbb bbbb  baaa aaaa
  132|       |  //
  133|       |  // On x86-64, a shld from a single register filled with enough 1s in the high
  134|       |  // bits can accomplish all this in one instruction. It so happens that res1
  135|       |  // has 57 high bits of ones, which is enough for the largest shift done.
  136|       |  //
  137|       |  // Just as importantly, by keeping results in res1, res2, and res3, we take

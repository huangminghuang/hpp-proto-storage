   48|  6.15k|            static_cast<unsigned>(std::countl_zero(std::make_unsigned_t<decltype(value)>(value) | 1U)) +
   49|  6.15k|            (CHAR_BIT - 2)) /
   50|       |           (CHAR_BIT - 1);
   51|  6.15k|  }
   52|  6.15k|}

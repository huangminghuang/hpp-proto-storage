   94|    596|  auto value = std::make_unsigned_t<typename VarintType::encode_type>(item.value);
   95|       |  if constexpr (varint_encoding::zig_zag == decltype(item)::encoding) {
   96|       |    // NOLINTNEXTLINE(hicpp-signed-bitwise)
   97|       |    value = (value << 1U) ^ static_cast<decltype(value)>(item.value >> (sizeof(value) * CHAR_BIT - 1U));

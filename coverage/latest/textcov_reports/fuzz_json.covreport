  162|       |
  163|  45.4k|  const auto done1 = [&] {
  164|  45.4k|    res1 &= res2;
  165|  45.4k|    return p;
  166|  45.4k|  };
  167|       |
  168|  45.4k|  const auto done2 = [&] {

  973|    892|      [&](auto &it_ref, auto &end_ref) {
  974|    892|        static constexpr auto Opts = opening_handled_off<ws_handled<Options>()>();
  975|    892|        if (key == "@type") [[unlikely]] {
  976|    892|          skip_value<JSON>::template op<Opts>(ctx, it_ref, end_ref);
  977|    892|        } else {
  978|    892|          const auto *desc = message.field_descriptor_by_json_name(key);
  979|    892|          if (desc == nullptr) {
  980|    892|            desc = message.field_descriptor_by_name(key);
  981|    892|          }
  982|    892|          if (desc == nullptr) {
  983|    892|            if constexpr (Opts.error_on_unknown_keys) {
  984|    892|              ctx.error = error_code::unknown_key;
  985|    892|              return true;
  986|    892|            }
  987|    892|            skip_value<JSON>::template op<Opts>(ctx, it_ref, end_ref);
  988|    892|          } else {

   42|  14.4k|constexpr auto varint_size(auto value) {
   43|       |  if constexpr (Encoding == varint_encoding::zig_zag) {
   44|       |    // NOLINTNEXTLINE(hicpp-signed-bitwise)
   45|       |    return varint_size(std::make_unsigned_t<decltype(value)>((value << 1) ^ (value >> (sizeof(value) * CHAR_BIT - 1))));
   46|  14.4k|  } else {
   47|  14.4k|    return ((sizeof(value) * CHAR_BIT) -
   48|  14.4k|            static_cast<unsigned>(std::countl_zero(std::make_unsigned_t<decltype(value)>(value) | 1U)) +
   49|  14.4k|            (CHAR_BIT - 2)) /
   50|       |           (CHAR_BIT - 1);
   51|  14.4k|  }
   52|  14.4k|}

  974|    274|      [&](auto &it_ref, auto &end_ref) {
  975|    274|        static constexpr auto Opts = opening_handled_off<ws_handled<Options>()>();
  976|    274|        if (key == "@type") [[unlikely]] {
  977|    274|          skip_value<JSON>::template op<Opts>(ctx, it_ref, end_ref);
  978|    274|        } else {
  979|    274|          const auto *desc = message.field_descriptor_by_json_name(key);
  980|    274|          if (desc == nullptr) {
  981|    274|            desc = message.field_descriptor_by_name(key);
  982|    274|          }
  983|    274|          if (desc == nullptr) {
  984|    274|            if constexpr (Opts.error_on_unknown_keys) {
  985|    274|              ctx.error = error_code::unknown_key;
  986|    274|              return true;
  987|    274|            }
  988|    274|            skip_value<JSON>::template op<Opts>(ctx, it_ref, end_ref);
  989|    274|          } else {

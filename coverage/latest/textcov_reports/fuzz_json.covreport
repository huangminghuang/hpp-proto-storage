   48|  4.26k|            static_cast<unsigned>(std::countl_zero(std::make_unsigned_t<decltype(value)>(value) | 1U)) +
   49|  4.26k|            (CHAR_BIT - 2)) /
   50|       |           (CHAR_BIT - 1);
   51|  4.26k|  }

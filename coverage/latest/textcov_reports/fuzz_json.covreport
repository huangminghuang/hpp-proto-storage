  152|  45.4k|    res &= shl_byte(n, byte, ones);
  153|  45.4k|    return res >= 0;
  154|  45.4k|  };
  155|       |
  156|  45.4k|  constexpr auto shl = [shl_byte](int n, int8_t byte, int64_t ones, int64_t &res) {
  157|  45.4k|    res = shl_byte(n, byte, ones);
  158|  45.4k|    return res >= 0;
  159|  45.4k|  };

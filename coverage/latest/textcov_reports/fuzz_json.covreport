  147|  45.9k|  constexpr auto shl_byte = [](int n, int8_t byte, int64_t ones) constexpr -> int64_t {
  148|  45.9k|    return static_cast<int64_t>((static_cast<uint64_t>(byte) << n * 7) | (static_cast<uint64_t>(ones) >> (64 - n * 7)));

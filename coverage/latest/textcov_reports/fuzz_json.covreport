  120|  22.0k|                                      int64_t &res1) -> decltype(std::ranges::cdata(input)) {
  121|       |  // The algorithm relies on sign extension for each byte to set all high bits
  122|       |  // when the varint continues. It also relies on asserting all of the lower
  123|       |  // bits for each successive byte read. This allows the result to be aggregated
  124|       |  // using a bitwise AND. For example:
  125|       |  //
  126|       |  //          8       1          64     57 ... 24     17  16      9  8       1
  127|       |  // ptr[0] = 1aaa aaaa ; res1 = 1111 1111 ... 1111 1111  1111 1111  1aaa aaaa

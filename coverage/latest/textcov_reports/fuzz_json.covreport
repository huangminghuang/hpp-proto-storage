   93|    596|[[nodiscard]] constexpr Byte *unchecked_pack_varint(VarintType item, Byte *data) {
   94|    596|  auto value = std::make_unsigned_t<typename VarintType::encode_type>(item.value);
   95|       |  if constexpr (varint_encoding::zig_zag == decltype(item)::encoding) {
   96|       |    // NOLINTNEXTLINE(hicpp-signed-bitwise)
   97|       |    value = (value << 1U) ^ static_cast<decltype(value)>(item.value >> ((sizeof(value) * CHAR_BIT) - 1U));
   98|       |  }
   99|       |
  100|       |  // NOLINTBEGIN(cppcoreguidelines-pro-bounds-pointer-arithmetic)
  101|    632|  while (value >= 0x80) {
  ------------------
  |  Branch (101:10): [True: 36, False: 596]
  ------------------
  102|     36|    *data++ = Byte((value & 0x7fU) | 0x80U);
  103|     36|    value >>= static_cast<unsigned>(CHAR_BIT - 1);
  104|     36|  }
  105|    596|  *data++ = Byte(value);
  106|       |  // NOLINTEND(cppcoreguidelines-pro-bounds-pointer-arithmetic)
